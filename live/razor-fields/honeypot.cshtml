@inherits Custom.Hybrid.RazorTyped
@using ToSic.Razor.Blade
@using AppCode.Data
@{
  var field = MyModel.Get<FormFieldConfig>("field");
}

<div class="app-mobius6-form-fields">
  <input type='@(MyUser.IsContentAdmin ? "text" : "hidden")' id="Honeypot" required data-pristine-honeypot="@field.String("DefaultValue")" class="hiddenInputStyle form-control mb-3" value="">
</div>

@if (MyUser.IsContentAdmin) {
  if (!Text.Has(field.String("DefaultValue"))) {
    <div class="alert alert-danger">
      <strong>Warnung:</strong> Das Honeypot-Feld hat keinen Standardwert.
    </div>
  }
  
  <div class="alert alert-warning">
    <strong>Achtung:</strong> Das Formular enthält ein Formularfeld, welches durch JavaScript nach einigen Sekunden befüllt wird. Das Formular prüft beim Absenden, ob der befüllte Wert korrekt ist (Honeypot).
  </div>
}

<script>
  window.setTimeout(function() {
    var honeypotValue = "@field.String("DefaultValue")";
    var honeypotElement = document.getElementById("module-@MyContext.Module.Id").querySelector("#Honeypot");
    if (honeypotElement && !honeypotElement.value) {
      honeypotElement.value = honeypotValue;
    }
  }, 5000)
</script>