@* Inherit special Base Class which Prepares a lot of commonly used objects *@
@inherits AppCode.Razor.MobiusRazorBase
@using ToSic.Sxc.Adam

@using System.Collections.Generic
@using System.Linq
@using System.Text.Json

@using AppCode.FormData

@if (!MyUser.IsContentAdmin)
  return;

@{
  var formData = GetService<FormDataService>().Setup(FormConfig.Id);
  var hasData = formData.Data.Any();
  var firstRecord = hasData ? formData.Data.First().Item.DateTime("Timestamp") : (DateTime?)null;
  var lastRecord = hasData ? formData.Data.Last().Item.DateTime("Timestamp") : (DateTime?)null;

  // Unique ids
  var tableId = $"formdata-{MyContext.Module.Id}-{formData.FormId}";
  var configId = $"{tableId}-config";
  var rowArtifactsId = $"{tableId}-row-artifacts";
  var searchId = $"{tableId}-search";
  var pageSizeId = $"{tableId}-page-size";
  var columnChooserId = $"{tableId}-columns";

  // Dynamic columns
  var tableColumns = formData.ColumnHeaders.Select(header => new {
    title = header.Value,
    field = header.Key,
    sorter = header.Key == "Id" || header.Key == "Files" ? "number" : "string"
  }).ToList();

  var tableRows = new List<Dictionary<string, object>>();
  foreach (var pair in formData.Data) {
    
    var row = new Dictionary<string, object>();

    foreach (var key in formData.ColumnHeaders.Keys) {
      row[key] = key == "Id" || key == "Files"
        ? pair.Get(key)
        : pair.GetString(key);
    }
    row["_itemId"] = pair.Item.Id;
    tableRows.Add(row);
  }

  // Data for Tabulator
  var tableConfigJson = JsonSerializer.Serialize(new {
    columns = tableColumns,
    rows = tableRows
  });
}

@* Header Bar showing Stats and CSV download *@
<div class="alert alert-primary d-flex flex-wrap align-items-center gap-2" role="alert" @Kit.Toolbar.Default()>
  <strong>Total:</strong> @formData.Data.Count
  @if (firstRecord.HasValue) {
    <strong>@AppRes.LabelFirst:</strong> @firstRecord.Value.ToString("yyyy-MM-dd")
    <strong>@AppRes.LabelLast:</strong> @lastRecord.Value.ToString("yyyy-MM-dd")
  }
  <strong>ModuleId:</strong> @MyContext.Module.Id
  <strong>FormId:</strong> @formData.FormId
  <a href="@CsvHelper.GetDownloadLink(formData.FormId)" type="button" class="btn btn-primary" target="_blank">CSV Export</a>
</div>

@* Add Table Tools *@
<div class="mobius-data-toolbar d-flex flex-wrap align-items-center gap-2 mb-3">
  <label class="d-flex align-items-center gap-2 mb-0" for="@pageSizeId">
    Show
    <select id="@pageSizeId" class="form-select form-select-sm mobius-data-page-size">
      <option value="10">10</option>
      <option value="25" selected>25</option>
      <option value="50">50</option>
      <option value="100">100</option>
    </select>
  </label>

  <label class="d-flex flex-grow-1 align-items-center gap-2 mb-0" for="@searchId">
    Search
    <input id="@searchId" class="form-control form-control-sm mobius-data-search" type="search" placeholder="Search all fields…" />
  </label>

  <details class="mobius-data-column-picker position-relative">
    <summary class="btn btn-sm btn-outline-secondary">Columns</summary>
    <div id="@columnChooserId" class="mobius-data-column-options bg-body border rounded shadow-sm p-2"></div>
  </details>
</div>

<div id="@tableId" class="mobius-data-table"></div>

@* Hidden 2sxc toolbars and file links for the table rows *@
<div id="@rowArtifactsId" hidden>
  @foreach (var pair in formData.Data) {
    var itemId = pair.Item.Id;
    var files = pair.Item.Folder("Files").Files;

    <div data-mobius-row-artifact="@itemId" @Kit.Toolbar.Empty(pair.Item).Delete().Settings(autoAddMore: "end", hover: "left")></div>

    <div data-mobius-files-artifact="@itemId">
      @if (files.Any()) {
        <details class="mobius-data-files">
          <summary class="badge rounded-pill text-bg-primary">@files.Count()</summary>
          <div class="mobius-data-file-list bg-body border rounded shadow-sm p-2">
            @foreach (IFile file in files) {
              <a class="d-block text-nowrap" href="@file.Url" download="@file.Name">
                @file.FullName (@file.SizeInfo.BestSize.ToString("##.#") @file.SizeInfo.BestUnit)
              </a>
            }
          </div>
        </details>
      }
    </div>
  }
</div>

<script type="application/json" id="@configId">@Html.Raw(tableConfigJson)</script>

<link rel="stylesheet" href="@MyView.Folder.Url/dist/tabulator.min.css" @Kit.Page.AssetAttributes()>
<script src="@MyView.Folder.Url/dist/tabulator.min.js" @Kit.Page.AssetAttributes()></script>
@Kit.Page.TurnOn("window.appMobius6.initDataTable()", data: new {
  tableId,
  configId,
  rowArtifactsId,
  searchId,
  pageSizeId,
  columnChooserId,
  persistenceId = $"mobius-data-{MyContext.Module.Id}-{formData.FormId}"
})

<link rel="stylesheet" href="@MyView.Folder.Url/dist/styles.min.css" @Kit.Page.AssetAttributes()>
<script src="@MyView.Folder.Url/dist/scripts.min.js" @Kit.Page.AssetAttributes()></script>
